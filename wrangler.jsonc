{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "territory-signals-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
  // Worker secrets (npx wrangler secret put <NAME>): RESEND_API_KEY, RESEND_FROM, TURNSTILE_SECRET_KEY.
  // PUBLIC_TURNSTILE_SITE_KEY and the optional PUBLIC_GA4_ID are read at build time from .env.production.
}
