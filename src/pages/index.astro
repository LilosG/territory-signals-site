---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import CtaBand from '../components/layout/CtaBand.astro';
import Button from '../components/ui/Button.astro';
import ParcelTexture from '../components/visuals/ParcelTexture.astro';
import Showcase from '../components/product/Showcase.astro';
import RecipeGrid from '../components/product/RecipeGrid.astro';
import DataTable from '../components/ui/DataTable.astro';
import DefinitionList from '../components/ui/DefinitionList.astro';
import FaqList from '../components/ui/FaqList.astro';
import SignalStack from '../components/visuals/SignalStack.astro';
import TerritoryMap from '../components/visuals/TerritoryMap.astro';
import BlockedDraft from '../components/product/BlockedDraft.astro';
import { PAGES } from '../data/pages.ts';
import { CTA } from '../data/site.ts';
import { NOT_SCRAPED, SOURCES } from '../data/sources.ts';
import { faqFor } from '../lib/collections.ts';
import { faqPage, service } from '../lib/schema.ts';

const meta = PAGES['/'];
const faqs = await faqFor('home');
const scattered = [
  ['Building permit approval', 'City development services', 'What work was approved, and when'],
  ['Rental license file', 'City treasurer', 'Whether an address still appears as licensed'],
  ['Tax-default list', 'County treasurer-tax collector', 'Which parcels are subject to power to sell'],
  ['Parcel and zoning layers', 'SanGIS and SANDAG', 'Lot size, zone and planning area'],
  ['Owner and recorder history', 'ATTOM', 'Tenure, mortgage status and recorded documents'],
];
const steps = [
  ['01', 'Collect', 'Public files and owner records are pulled on a weekly run. Each raw record is kept, never overwritten.'],
  ['02', 'Connect', 'Records are cleaned and matched to a parcel by parcel number, location, address or name. Every match keeps its confidence.'],
  ['03', 'Score', 'Published weights, recency decay and stacking rules turn matched signals into a score from 0 to 100.'],
  ['04', 'Act', 'Ranked parcels become dossiers and drafted outreach. A person approves each draft, and your team sends it.'],
];
---
<BaseLayout meta={meta} schema={[service(), faqPage(faqs)]}>
  <div class="home-hero on-dark section-dark" data-dark-band>
    <ParcelTexture id="hero" />
    <Container>
      <div class="grid-12 items-center">
        <div class="min-w-0 lg:col-span-6">
          <p class="eyebrow">Territory intelligence for real estate teams</p>
          <h1 class="mt-5 text-hero">{meta.h1}</h1>
          <p class="lede mt-7" data-answer>Territory Signals pulls permits, rental licenses, tax-roll lines and owner records into one place, matches each to a parcel, scores it with published rules and hands your team ranked properties, the evidence behind them and drafted outreach that a person approves before your team sends it.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <Button href={CTA.primary.href} location="hero">{CTA.primary.label}</Button>
            <Button href={CTA.secondary.href} variant="secondary" location="hero">{CTA.secondary.label}</Button>
          </div>
        </div>
        <div class="home-hero-visual min-w-0 lg:col-span-6"><SignalStack /></div>
      </div>
    </Container>
  </div>

  <Section>
    <div class="grid-12">
      <div class="col-support stack">
        <h2>Where do seller signals sit before a home is listed?</h2>
        <p>Seller signals sit in separate public and owner records that no listing search brings together. Each has its own publisher, format and schedule, and most carry no hint of the others.</p>
        <p class="pull">The MLS shows what everyone can see. The records that can come first are scattered.</p>
      </div>
      <div class="col-lead self-center">
        <DataTable caption="Where the records live" showCaption columns={['Record', 'Publisher', 'What it can show']} rows={scattered} />
      </div>
    </div>
  </Section>

  <Section>
    <div class="grid-12">
      <div class="col-support stack lg:sticky lg:top-24 lg:self-start">
        <h2>How do seller signals become a worked lead?</h2>
        <p>Seller signals become a worked lead in four steps, each of which leaves a record your team can check.</p>
        <p class="text-sm text-ink-muted">An optional AI layer explains: it writes short, validated summaries that cite their records. It never scores.</p>
        <p><a class="link" href="/how-it-works">How scoring works, step by step</a></p>
      </div>
      <ol class="steps col-lead">
        {steps.map(([n, name, text]) => (
          <li class="step">
            <p class="step-numeral">{n}</p>
            <h3 class="sr-only">{name}: seller signals</h3>
            <p class="mt-4 font-serif text-2xl font-medium" aria-hidden="true">{name}</p>
            <p class="mt-3 text-ink-muted">{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section>
    <div class="grid-12 items-end">
      <h2 class="col-lead">Which seller signals does each recipe combine?</h2>
      <div class="col-support stack">
        <p>Each recipe combines specific seller signals and owner facts under a written rule. These are the product’s own labels.</p>
        <p><a class="link" href="/recipes">Read every recipe rule</a></p>
      </div>
    </div>
    <div class="mt-10"><RecipeGrid /></div>
  </Section>

  <Section tone="dark" id="showcase">
    <div class="max-w-3xl">
      <h2>How does your team work these seller signals?</h2>
      <p class="lede mt-5">Your team works seller signals from a ranked list, opens the evidence behind a parcel and approves a draft. These are the product’s surfaces, shown with invented sample records.</p>
      <p class="mt-4"><a class="link" href="/platform">Explore the platform</a></p>
    </div>
    <div class="mt-14"><Showcase /></div>
  </Section>

  <Section label="Approval rule">
    <div class="grid-12 items-center">
      <figure class="col-lead">
        <p class="eyebrow">Approval rule</p>
        <p class="mt-5 border-l-2 border-gold pl-6 font-serif text-section">A draft stays blocked until the agent’s name and license number are on it.</p>
      </figure>
      <div class="col-support"><BlockedDraft /></div>
    </div>
  </Section>

  <Section>
    <div class="max-w-3xl">
      <h2>Which data sources feed the seller signals?</h2>
      <p class="mt-4">The seller signals come from the sources below, each carrying the verdict from our own source review.</p>
    </div>
    <div class="mt-8">
      <DataTable caption="Data sources and verdicts" columns={['Source', 'Verdict', 'What it provides']} rows={SOURCES.map((s) => [{ text: s.name, href: s.url, icon: s.key }, { text: s.verdict, pill: true }, s.provides])} />
      <p class="mt-4 max-w-measure text-sm text-ink-muted">Not scraped: {NOT_SCRAPED.map((n) => n.term.toLowerCase()).join(', ')}. <a class="link" href="/data-sources">Why, and every source limit</a>.</p>
    </div>
  </Section>

  <Section label="The market">
    <div class="grid-12 items-center">
      <div class="col-support stack">
        <p class="eyebrow">The market</p>
        <p class="font-serif text-2xl">San Diego is the live market. A territory is any set of City planning areas your team chooses.</p>
        <p><a class="link" href="/markets/san-diego">San Diego coverage</a></p>
      </div>
      <div class="col-lead"><TerritoryMap /></div>
    </div>
  </Section>

  <Section>
    <div class="grid-12">
      <div class="col-support stack">
        <h2>Who approves outreach built on seller signals?</h2>
        <p class="text-ink-muted">A person on your team approves every piece of outreach built on seller signals, and your team sends it.</p>
        <p><a class="link" href="/compliance">Compliance in detail</a></p>
      </div>
      <dl class="col-lead border-t-2 border-ink">
        {[
          ['Human approval', 'Drafts are edited and approved one by one. Bulk approval still applies every rule to each draft.'],
          ['DRE license rule', 'A draft cannot be approved without the agent’s name and DRE license number.'],
          ['No automatic contact', 'The system never sends, texts or dials a homeowner.'],
          ['Sensitive records', 'They stay off lead cards, lists and share pages, and homeowner text never mentions them.'],
        ].map(([t, d]) => (
          <div class="border-b border-line py-5 sm:grid sm:grid-cols-3 sm:gap-6">
            <dt class="font-semibold">{t}</dt>
            <dd class="mt-1 text-ink-muted sm:col-span-2 sm:mt-0">{d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section>
    <div class="grid-12">
      <div class="col-support stack">
        <h2>How are seller signals set up for your team?</h2>
        <p>Seller signals are set up per team or brokerage: one deployment per client, configured to the planning areas you choose and run as a managed service. It is not self-serve software, and it is not priced per lead.</p>
        <p><a class="link" href="/how-we-build">What onboarding involves</a></p>
      </div>
      <div class="col-lead self-center">
        <DefinitionList items={[
          { term: 'Your territory', definition: 'The City planning areas you choose, with your agents and license details.' },
          { term: 'Managed', definition: 'Built and run for you, with a weekly data run and visible source health.' },
          { term: 'MLS add-on', definition: 'Optional and scoped per client. It requires your broker’s signed back-office data agreement. The core product runs without it.' },
        ]} />
      </div>
    </div>
  </Section>

  <Section>
    <div class="grid-12">
      <div class="col-support stack">
        <h2>What do teams ask about seller signals?</h2>
        <p>Teams ask where seller signals come from, how they are scored and what happens before anyone is contacted.</p>
        <p><a class="link" href="/faq">All questions</a></p>
      </div>
      <div class="col-lead"><FaqList items={faqs} /></div>
    </div>
  </Section>

  <CtaBand tone="light" title="Which seller signals are in your territory?" text="Tell us the market and neighborhoods you work. We walk through the records that cover them and how each would score." />
</BaseLayout>

<style>
  .home-hero { display: flex; align-items: center; min-height: 88vh; padding-block: 4rem 5rem; }
  .home-hero > :global(.page-container) { flex: 1; }
  .home-hero :global(.lede) { max-width: 36rem; }
  @media (min-width: 64rem) {
    .home-hero-visual { padding-left: 1rem; }
  }
  /* Four steps: a 2 x 2 grid beside the heading on wide screens, one column on narrow ones. */
  .steps { display: grid; gap: 0; border-top: 1px solid var(--color-line-strong); }
  .step { position: relative; padding: 2rem 0 2rem 1.5rem; border-bottom: 1px solid var(--color-line); }
  .step::before { content: ''; position: absolute; top: 2.75rem; left: 0; width: 0.5rem; height: 0.5rem; border-radius: var(--radius-full); background: var(--color-gold); }
  .step-numeral { font-family: var(--font-mono); font-size: var(--text-numeral); line-height: var(--text-numeral--line-height); letter-spacing: var(--tracking-display); color: var(--color-ink); font-variant-numeric: tabular-nums; }
  @media (min-width: 48rem) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step { padding: 2.25rem 2rem 2.25rem 1.75rem; }
    .step:nth-child(odd) { border-right: 1px solid var(--color-line); }
  }
</style>
