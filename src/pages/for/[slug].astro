---
import AudiencePage from '../../templates/AudiencePage.astro';
import { entries } from '../../lib/collections.ts';

export async function getStaticPaths() {
  return (await entries('audiences')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
---
<AudiencePage entry={Astro.props.entry} />
