---
import StandardPage from '../templates/StandardPage.astro';
import Section from '../components/layout/Section.astro';
import QaSection from '../components/layout/QaSection.astro';
import DataTable from '../components/ui/DataTable.astro';
import WeightTable from '../components/templates/WeightTable.astro';
import TierCards from '../components/templates/TierCards.astro';
import QaGrid from '../components/layout/QaGrid.astro';
import ListCard from '../components/templates/ListCard.astro';
import FaqList from '../components/ui/FaqList.astro';
import RelatedLinks from '../components/ui/RelatedLinks.astro';
import ScoreDemo from '../components/visuals/ScoreDemo.astro';
import { PAGES } from '../data/pages.ts';
import { CATALOG, SCORING } from '../lib/product.ts';
import { faqFor } from '../lib/collections.ts';
import { faqPage } from '../lib/schema.ts';

const meta = PAGES['/how-it-works'];
const faqs = await faqFor('how-it-works');
const weightComponents = CATALOG.components.filter((c) => c.max_points > 0).map((c) => ({ key: c.key, label: c.label, maxPoints: c.max_points }));
const pct = (n: number) => `${Math.round(n * 100)}%`;
const steps = [
  { label: '01  Collect public and owner records', value: 'weekly' },
  { label: '02  Connect each record to a parcel', value: 'traced' },
  { label: '03  Score with published weights', value: '0–100' },
  { label: '04  Act on approved drafts', value: 'human' },
  { label: '05  Explain in cited text', value: 'AI, optional' },
];
---
<StandardPage meta={meta} eyebrow="Collect → Connect → Score → Act → Explain" schema={[faqPage(faqs)]}
  answer="Predictive seller scoring here is transparent arithmetic. Records are collected, matched to parcels and given published weights that fade with age and reflect match confidence. Independent signal families stack, the total is capped at 100, and a person decides what happens next. AI explains in cited text and never sets a score."
  request="To walk through these rules against your own planning areas,"
  cta={{ title: 'See seller scoring on your own San Diego territory', text: 'A walkthrough shows the records that cover your areas and the components behind each score.' }}>
  <ListCard slot="aside" title="Seller scoring, step by step" stats={[{ value: `+${pct(SCORING.stacking.bonus_per_extra_family)}`, label: 'Per extra family' }, { value: `+${pct(SCORING.stacking.cap)}`, label: 'Largest bonus' }, { value: '100', label: 'Score cap' }]} rows={steps} note={`Scoring model ${SCORING.model_version}.`} />

  <QaGrid items={[
    { id: 'collect', q: 'What does seller scoring collect first?', p: ['Seller scoring starts by collecting records from City, County and regional files plus owner and recorder data. A weekly run pulls each source in a fixed order, keeps every raw record without overwriting it and logs what succeeded. If one source fails, the failure is recorded and the others continue.'], links: [{ href: '/data-sources', label: 'Every source and its limits' }] },
    { id: 'connect', q: 'How does seller scoring connect records to parcels?', p: ['Seller scoring connects a record to a parcel using its parcel number first, then location, address or name where a source has no parcel number. Each signal stores its source, source record ID, match method and match confidence, so any line on a lead can be traced back to where it came from.'] },
  ]} />

  <Section id="score">
    <div class="grid-12 items-start gap-y-10">
      <div class="min-w-0 lg:col-span-5">
        <h2>What is the seller scoring formula?</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">The seller scoring formula adds up each signal’s weighted, age-adjusted contribution and then applies a bonus for independent families.</p>
      </div>
      <div class="min-w-0 space-y-5 lg:col-span-7">
        <div class="on-dark rounded-2xl bg-obsidian p-6 text-on-dark">
          <p class="eyebrow">The formula</p>
          <p class="mono mt-4 text-[15px] leading-loose">contribution = weight × 0.5^(age ÷ half-life) × confidence<br />score = min(100, round(sum × (1 + stacking bonus)))</p>
        </div>
        <DataTable caption="Stacking and caps" columns={['Rule', 'Value']} rows={[
          ['Bonus per independent family after the first', `+${pct(SCORING.stacking.bonus_per_extra_family)}`],
          ['Largest stacking bonus', `+${pct(SCORING.stacking.cap)}`],
          ['Cap on all owner modifiers together', `${SCORING.owner_modifiers.cap} points`],
          ['Cap on the final score', '100'],
          ['Repeat records of one signal type', 'Only the strongest, most recent one counts'],
          ['Out-of-state and absentee owner', 'Not added together'],
        ]} />
      </div>
    </div>
  </Section>

  <Section id="demo">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl"><p class="eyebrow">Try it</p><h2 class="mt-4">How does seller scoring change as signals stack?</h2></div>
      <p class="max-w-sm text-ink-muted">Turn signals on and off. The parcel is invented; the weights and formula are the product’s.</p>
    </div>
    <div class="demo-frame mt-10"><ScoreDemo /></div>
  </Section>

  <Section>
    <div class="max-w-3xl">
      <h2>What do the seller scoring tiers mean?</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">Seller scoring tiers are display bands that tell your team what to look at first. They do not change the stored number.</p>
    </div>
    <div class="mt-10"><TierCards /></div>
  </Section>

  <QaSection layout="wide" q="Which weights does seller scoring use?" p={[`Seller scoring uses the weights below, from scoring model ${SCORING.model_version}. They are set by hand and published to every team.`]}>
    <WeightTable caption={`Score component weights, model ${SCORING.model_version}`} components={weightComponents} showFamily />
  </QaSection>

  <QaGrid columns={3} items={[
    { q: 'When does seller scoring skip a parcel?', p: ['Seller scoring skips parcels where a score would mislead or waste time.'], list: [
      'The parcel’s land use is not residential.',
      `A recorded sale falls within the last ${SCORING.suppression.recent_sale_months} months. Transfers by death, trust or inheritance are not treated as sales.`,
      'The team has an active suppression on the parcel.',
    ] },
    { id: 'act', q: 'What happens after seller scoring?', p: ['After seller scoring, parcels are matched to named playbooks, ranked in the product and, where your team chooses, turned into drafted outreach. A person edits and approves each draft, your team sends it, and outcomes are logged so you can see what happened.'], links: [{ href: '/recipes', label: 'Seller playbooks' }, { href: '/platform/outreach-co-pilot', label: 'Outreach co-pilot' }] },
    { id: 'explain', q: 'Does AI play a part in seller scoring?', p: [
      'No part of seller scoring uses AI. Scores, counts, dates, equity and eligibility come from deterministic code.',
      'The optional AI layer writes cited lead and weekly summaries. Every output is checked against its records, rejected output is never shown, and sensitive records are left out.',
    ] },
  ]} />

  <Section>
    <div class="grid-12 gap-y-12">
      <div class="min-w-0 lg:col-span-7">
        <h2>What else do teams ask about seller scoring?</h2>
        <div class="mt-8"><FaqList items={faqs} /></div>
      </div>
      <div class="min-w-0 lg:col-span-4 lg:col-start-9">
        <RelatedLinks title="Keep reading" links={[
          { href: '/signals', label: 'Signal families', note: 'Each source, weight and limit' },
          { href: '/platform/lead-scoring', label: 'Lead scoring in the product' },
          { href: '/platform/backtesting', label: 'Backtesting' },
          { href: '/glossary', label: 'Glossary' },
        ]} />
      </div>
    </div>
  </Section>
</StandardPage>
<style>
  .demo-frame { border-radius: var(--radius-2xl); box-shadow: var(--shadow-card); }
</style>
