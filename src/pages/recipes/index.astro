---
import HubPage from '../../templates/HubPage.astro';
import RecipeGrid from '../../components/product/RecipeGrid.astro';
import { PAGES } from '../../data/pages.ts';
import { entries, linkList } from '../../lib/collections.ts';
const list = await entries('recipes');
const items = linkList('recipes', list).map((item, i) => ({ ...item, mark: list[i]!.data.mark }));
---
<HubPage meta={PAGES['/recipes']} eyebrow="Named patterns" items={items}
  answer="Seller lead recipes are named patterns, each defined by a written rule over signals and owner facts. There are nine, from Downsizer to Stalled project. A parcel either meets a recipe or does not, and matching adds no points. Quiet inheritance and Financial pressure need team approval, and Insurance squeeze waits on fire data."
  request="To see which recipes your territory would match,"
  cta={{ title: 'Which seller playbook would your team work first?', text: 'We walk through each rule against the planning areas you choose.' }}
  index={{ q: 'What does each seller playbook look for?', p: ['Each seller playbook looks for a specific combination of facts. The labels and short descriptions below are the product’s own.'] }}
  sections={[
    { q: 'How is a recipe different from a score?', p: ['A recipe is different from a score because it answers what kind of situation a parcel is in, while the score answers how much recent evidence it carries. A parcel can match several recipes; the one whose components add the most points leads.'] },
    { q: 'Which recipe needs extra care?', p: ['Any recipe built on distress or inheritance records needs extra care. Those records never appear on lead lists or share pages, outreach needs team approval and homeowner text never mentions them.'] },
  ]}>
  <RecipeGrid slot="index" />
</HubPage>
