---
import Container from './Container.astro';
import ParcelTexture from '../visuals/ParcelTexture.astro';
interface Props { tone?: 'light' | 'dark'; id?: string; label?: string; class?: string }
const { tone = 'light', id, label, class: cls } = Astro.props;
const dark = tone === 'dark';
---
<section id={id} aria-label={label} data-dark-band={dark ? '' : undefined} class:list={['section', dark && 'on-dark section-dark', cls]}>
  {dark && <ParcelTexture id={id ?? 'band'} />}
  <Container><slot /></Container>
</section>
