---
import Container from './Container.astro';
interface Props { tone?: 'canvas' | 'surface' | 'sunken' | 'dark'; ruled?: boolean; id?: string; label?: string; class?: string }
const { tone = 'canvas', ruled = true, id, label, class: cls } = Astro.props;
const tones = { canvas: '', surface: 'bg-surface', sunken: 'bg-sunken', dark: 'on-dark section-dark' };
---
<section id={id} aria-label={label} data-dark-band={tone === 'dark' ? '' : undefined} class:list={['section', ruled && tone !== 'dark' && 'section-ruled', tones[tone], cls]}>
  <Container><slot /></Container>
</section>
