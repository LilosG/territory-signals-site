---
import Container from './Container.astro';
import MobileNav from './MobileNav.astro';
import { COMPANY, CTA, NAV, SITE } from '../../data/site.ts';
interface Props { current: string }
const { current } = Astro.props;
---
<header class="site-header on-dark sticky top-0 z-40">
  <Container class="flex h-header items-center justify-between gap-4">
    <a href="/" class="tap-link gap-2.5 text-[17px] font-semibold tracking-heading text-on-dark">
      <svg class="size-7" viewBox="0 0 28 28" aria-hidden="true"><path d="M4 9 14 3l10 6v10l-10 6-10-6z" fill="none" stroke="currentColor" class="text-gold" stroke-width="1.6" /><path d="M9 12l5-3 5 3v5l-5 3-5-3z" class="fill-gold/20 text-gold" stroke="currentColor" stroke-width="1.2" /><circle cx="14" cy="14.5" r="1.8" class="fill-gold" /></svg>
      <span class="flex flex-col leading-none">
        <span>{SITE.name}</span>
        <span class="mt-1 text-[11px] font-normal tracking-normal text-on-dark-muted">by {COMPANY.name}</span>
      </span>
    </a>
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm">
        {NAV.map((l) => (
          <li><a class="nav-link tap-link" href={l.href} aria-current={current === l.href || current.startsWith(`${l.href}/`) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-3">
      <a class="btn btn-gold btn-sm hidden sm:inline-flex" href={CTA.primary.href} data-cta="primary" data-cta-location="header">{CTA.primary.short}</a>
      <MobileNav current={current} />
    </div>
  </Container>
</header>
<style>
  .site-header { background: var(--color-obsidian); border-bottom: 1px solid var(--color-line-dark); }
  .nav-link { color: var(--color-on-dark-muted); transition: color var(--duration-fast) var(--ease-quiet); }
  .nav-link:hover, .nav-link[aria-current='page'] { color: var(--color-on-dark); }
  .nav-link[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--color-gold); text-underline-offset: 8px; }
</style>
