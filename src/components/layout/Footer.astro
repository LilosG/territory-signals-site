---
import Container from './Container.astro';
import { COMPANY, FOOTER, LEGAL_LINKS, SITE } from '../../data/site.ts';
const year = new Date().getFullYear();
---
<footer class="on-dark site-footer py-14 text-sm">
  <Container>
    <div class="grid-12">
      <div class="lg:col-span-4">
        <p class="text-base font-semibold text-on-dark">{SITE.name}</p>
        <p class="mt-2 max-w-xs leading-relaxed">{SITE.tagline}. Built and run by <a class="link" href={COMPANY.url}>{COMPANY.name}</a>.</p>
        <address class="mt-4 not-italic leading-relaxed">
          <a class="link tap-link" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><br />
          {COMPANY.address.street}<br />
          {COMPANY.address.city}, {COMPANY.address.region} {COMPANY.address.postalCode}
        </address>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-8">
        {FOOTER.map((col) => (
          <nav aria-label={col.title}>
            <p class="eyebrow">{col.title}</p>
            <ul class="mt-2">
              {col.links.map((l) => <li><a class="footer-link tap-link" href={l.href}>{l.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line-dark pt-6">
      <p>© {year} {COMPANY.name}</p>
      <ul class="flex gap-5">{LEGAL_LINKS.map((l) => <li><a class="footer-link tap-link" href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </Container>
</footer>
<style>
  .site-footer { background: var(--color-obsidian); color: var(--color-on-dark-faint); border-top: 1px solid var(--color-line-dark); }
  .footer-link { color: var(--color-on-dark-faint); transition: color var(--duration-fast) var(--ease-quiet); }
  .footer-link:hover { color: var(--color-on-dark); }
</style>
