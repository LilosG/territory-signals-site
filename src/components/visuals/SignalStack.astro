---
/**
 * Hero composition: four unrelated records arrive one by one, a gold line ties each to the subject parcel, and the
 * score resolves last on a dossier card. CSS only. The resting styles are the finished state, so reduced motion and
 * no-animation both show the result. Sits on an obsidian band.
 */
import ParcelBlock from './ParcelBlock.astro';
import ScoreRing from '../ui/ScoreRing.astro';
import SampleBadge from '../ui/SampleBadge.astro';
import block from '../../data/parcel-block-demo.json';
import { HERO, WORKSPACE } from '../../data/demo.ts';
import { tierOf } from '../../lib/tiers.ts';
const tier = tierOf(HERO.score);

/*
 * Stage coordinates are percentages of a 600 x 500 stage. Records sit in a column on the left, the block on the right,
 * and the score card under the block, so nothing covers the parcels. These match the styles below.
 */
const STAGE = { w: 600, h: 500 };
const BLOCK = { left: 40, top: 3, width: 60 };
const PAD = 24;
const blockHeight = BLOCK.width * (STAGE.w / STAGE.h) * ((block.height + PAD * 2) / (block.width + PAD * 2));
const end = {
  x: BLOCK.left + ((block.subjectCenter[0]! + PAD) / (block.width + PAD * 2)) * BLOCK.width,
  y: BLOCK.top + ((block.subjectCenter[1]! + PAD) / (block.height + PAD * 2)) * blockHeight,
};
const ROW = { width: 36, top: 3, step: 17.5, height: 15.5 };
const links = HERO.records.map((_, i) => {
  const y = ROW.top + i * ROW.step + ROW.height / 2;
  const mid = (ROW.width + end.x) / 2;
  return `M${ROW.width} ${y.toFixed(2)}C${mid.toFixed(2)} ${y.toFixed(2)} ${mid.toFixed(2)} ${end.y.toFixed(2)} ${end.x.toFixed(2)} ${end.y.toFixed(2)}`;
});
const RESULT_TOP = 70;
const drop = `M${end.x.toFixed(2)} ${end.y.toFixed(2)}L${end.x.toFixed(2)} ${RESULT_TOP}`;
---
<figure class="signal-stack" aria-label="Sample: four separate records attach to one parcel and resolve into a score">
  <div class="stack-stage">
    <div class="stack-block"><ParcelBlock tone="dark" /></div>
    <svg class="stack-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {links.map((d) => <path class="stack-link" d={d} />)}
      <path class="stack-drop" d={drop} />
    </svg>
    <svg class="stack-node" aria-hidden="true" focusable="false"><circle class="stack-dot" cx={`${end.x}%`} cy={`${end.y}%`} r="5" /></svg>
    <ol class="stack-rows">
      {HERO.records.map((r) => (
        <li class="stack-row">
          <span class="stack-source">{r.source}</span>
          <span class="stack-fact">{r.fact}</span>
          <span class="stack-meta"><span>{r.record}</span><time datetime={r.date}>{r.date}</time></span>
        </li>
      ))}
    </ol>
    <div class="stack-result">
      <p class="flex items-center justify-between gap-2 border-b border-line bg-sunken px-4 py-2">
        <span class="mono text-2xs uppercase tracking-eyebrow text-ink-muted">{WORKSPACE} · one parcel</span>
        <SampleBadge />
      </p>
      <div class="flex items-center gap-4 px-4 py-3">
        <ScoreRing score={HERO.score} size="xl" />
        <div>
          <p class:list={['text-lg font-semibold', `tier-${tier.key}`]}>{tier.label}</p>
          <p class="num text-xs text-ink-muted">{HERO.families} families · ×{HERO.multiplier.toFixed(2)}</p>
          <p class="mono mt-1 text-2xs text-ink-muted">APN {HERO.apn}</p>
        </div>
      </div>
    </div>
  </div>
</figure>
<style>
  .stack-stage { display: flex; flex-direction: column; gap: 1rem; }
  .stack-rows { display: grid; gap: 0.5rem; order: 1; }
  .stack-block { order: 2; }
  .stack-links, .stack-node { display: none; }
  .stack-row {
    display: flex; flex-direction: column; justify-content: center; gap: 0.2rem;
    padding: 0.625rem 0.875rem; border: 1px solid var(--color-line-dark); border-left: 2px solid var(--color-gold-bright);
    border-radius: var(--radius-md); background: var(--color-obsidian-raised); box-shadow: var(--shadow-lift);
  }
  .stack-source, .stack-meta { font-family: var(--font-mono); font-size: var(--text-2xs); line-height: var(--text-2xs--line-height); font-variant-numeric: tabular-nums; }
  .stack-source { text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-gold-bright); }
  .stack-meta { display: flex; justify-content: space-between; gap: 0.75rem; color: var(--color-on-dark-muted); }
  .stack-fact { font-size: var(--text-sm); line-height: 1.3; font-weight: 500; color: var(--color-on-dark); }
  .stack-result {
    order: 3; position: relative; width: min(100%, 20rem); margin: -2rem 0 0 auto; overflow: hidden;
    border-radius: var(--radius-xl); background: var(--color-surface); color: var(--color-ink); box-shadow: var(--shadow-float);
  }

  @media (min-width: 40rem) {
    .stack-stage { display: block; position: relative; aspect-ratio: 600 / 500; }
    .stack-block { position: absolute; left: 40%; top: 3%; width: 60%; }
    .stack-links, .stack-node { display: block; position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
    .stack-rows { display: contents; }
    .stack-row { position: absolute; left: 0; width: 36%; height: 15.5%; z-index: 1; padding-block: 0.375rem; }
    .stack-row:nth-child(1) { top: 3%; }
    .stack-row:nth-child(2) { top: 20.5%; }
    .stack-row:nth-child(3) { top: 38%; }
    .stack-row:nth-child(4) { top: 55.5%; }
    .stack-result { position: absolute; right: 0; top: 70%; width: min(56%, 21rem); margin: 0; z-index: 2; }
  }

  .stack-link, .stack-drop { fill: none; stroke: var(--color-gold-bright); stroke-width: 1.25; stroke-opacity: 0.85; vector-effect: non-scaling-stroke; }
  .stack-drop { stroke-dasharray: 3 4; }
  .stack-dot { fill: var(--color-gold-bright); }

  .stack-row { animation: arrive var(--duration-slow) var(--ease-quiet) backwards; }
  .stack-row:nth-child(1) { animation-delay: 250ms; }
  .stack-row:nth-child(2) { animation-delay: 750ms; }
  .stack-row:nth-child(3) { animation-delay: 1250ms; }
  .stack-row:nth-child(4) { animation-delay: 1750ms; }
  .stack-link { animation: appear 400ms var(--ease-quiet) backwards; }
  .stack-link:nth-child(1) { animation-delay: 500ms; }
  .stack-link:nth-child(2) { animation-delay: 1000ms; }
  .stack-link:nth-child(3) { animation-delay: 1500ms; }
  .stack-link:nth-child(4) { animation-delay: 2000ms; }
  .stack-drop { animation: appear 300ms var(--ease-quiet) 2250ms backwards; }
  .stack-dot { animation: appear var(--duration-slow) var(--ease-quiet) 700ms backwards; }
  .stack-result { animation: arrive 400ms var(--ease-quiet) 2350ms backwards; }
  .stack-result :global(.ring-value) { animation: fill-ring 700ms var(--ease-quiet) 2500ms backwards; }

  @keyframes arrive { from { opacity: 0; transform: translateY(-0.5rem); } }
  @keyframes appear { from { opacity: 0; } }
  @keyframes fill-ring { from { stroke-dasharray: 0 100; } }
</style>
