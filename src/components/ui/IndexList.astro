---
/** The index grid every section hub uses, generated from a collection. The whole card is the link. */
import Icon from './Icon.astro';
interface Props { items: { href: string; label: string; note?: string | undefined; mark?: string | undefined }[]; columns?: 3 | 4 }
---
<ul class:list={['grid gap-5 sm:grid-cols-2', Astro.props.columns === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
  {Astro.props.items.map((i) => (
    <li class="flex">
      <a href={i.href} class="index-card">
        <span class="font-serif text-xl font-medium">{i.label}</span>
        {i.note && <span class="text-ink-muted">{i.note}</span>}
        <span class="mt-auto flex items-center justify-between gap-3 pt-2">
          <span class="mono text-2xs uppercase tracking-eyebrow text-ink-muted">{i.mark}</span>
          <Icon name="arrow" />
        </span>
      </a>
    </li>
  ))}
</ul>
<style>
  .index-card {
    display: flex; flex: 1; flex-direction: column; gap: 0.75rem; padding: 1.375rem 1.5rem;
    border: 1px solid var(--color-line); border-top: 3px solid var(--color-line); border-radius: var(--radius-lg);
    background: var(--color-surface); color: var(--color-ink);
    transition: transform var(--duration-fast) var(--ease-quiet), box-shadow var(--duration-fast) var(--ease-quiet), border-color var(--duration-fast);
  }
  .index-card:hover, .index-card:focus-visible { transform: translateY(-4px); border-top-color: var(--color-gold); box-shadow: var(--shadow-lift); }
</style>
