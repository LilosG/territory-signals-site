---
/** A real HTML table. Cells are strings or links; the first column is the row header. */
import '../../styles/table.css';
import StatusPill from './StatusPill.astro';
import SourceIcon from './SourceIcon.astro';
import type { SourceKey } from '../../data/sources.ts';
export type Cell = string | { text: string; href?: string; note?: string; mono?: boolean; pill?: boolean; icon?: SourceKey };
interface Props { caption: string; columns: string[]; rows: Cell[][]; showCaption?: boolean }
const { caption, columns, rows, showCaption = false } = Astro.props;
const norm = (c: Cell) => (typeof c === 'string' ? { text: c } : c) as Exclude<Cell, string>;
---
<div class="table-scroll table-card" role="region" aria-label={caption} tabindex="0">
  <table class="data-table">
    <caption class:list={[showCaption ? 'eyebrow px-5 pt-4 pb-3 text-left' : 'sr-only']}>{caption}</caption>
    <thead>
      <tr>{columns.map((c) => <th scope="col">{c}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((raw, i) => {
            const cell = norm(raw);
            const Tag = i === 0 ? 'th' : 'td';
            const external = cell.href?.startsWith('http');
            const label = cell.href ? 'link' : cell.pill ? 'pill' : 'text';
            return (
              <Tag scope={i === 0 ? 'row' : undefined} class:list={[cell.mono && 'mono text-xs']}>
                <div class:list={[cell.icon && 'flex gap-3']}>
                  {cell.icon && <SourceIcon source={cell.icon} />}
                  <div>
                    {label === 'link' ? <a class="link" href={cell.href} rel={external ? 'noopener' : undefined}>{cell.text}</a> : label === 'pill' ? <StatusPill value={cell.text} /> : cell.text}
                    {cell.note && <span class="mt-1 block text-xs font-normal text-ink-muted">{cell.note}</span>}
                  </div>
                </div>
              </Tag>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
