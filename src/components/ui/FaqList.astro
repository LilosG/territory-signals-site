---
interface Props { items: { id: string; question: string; answer: string }[] }
---
<dl class="border-t border-ink">
  {Astro.props.items.map((f) => (
    <div class="border-b border-line py-5 lg:grid lg:grid-cols-12 lg:gap-8" id={f.id}>
      <dt class="font-semibold lg:col-span-4">{f.question}</dt>
      <dd class="mt-2 max-w-measure text-ink-muted lg:col-span-8 lg:mt-0">{f.answer}</dd>
    </div>
  ))}
</dl>
