---
interface Props { tone?: 'neutral' | 'solid' | 'outline'; class?: string }
const { tone = 'neutral', class: cls } = Astro.props;
const tones = { neutral: 'bg-sunken text-ink-muted border-line', solid: 'bg-ink text-on-dark border-ink', outline: 'bg-surface text-ink border-line-strong' };
---
<span class:list={['inline-flex items-center gap-1.5 whitespace-nowrap rounded-full border px-2.5 py-1 text-2xs leading-none font-semibold', tones[tone], cls]}><slot /></span>
