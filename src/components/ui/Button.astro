---
interface Props { href?: string; variant?: 'primary' | 'secondary'; type?: 'button' | 'submit'; location?: string; class?: string; [key: string]: unknown }
const { href, variant = 'primary', type = 'button', location, class: cls, ...rest } = Astro.props;
const classes = ['btn', variant === 'primary' ? 'btn-primary' : 'btn-secondary', cls];
const tracking = location ? { 'data-cta': variant, 'data-cta-location': location } : {};
---
{href
  ? <a href={href} class:list={classes} {...tracking} {...rest}><slot /></a>
  : <button type={type} class:list={classes} {...tracking} {...rest}><slot /></button>}
