---
/** A signal's score components: what is in each, its published weight with a bar, and its half-life. */
import { weightFor } from '../../lib/product.ts';
interface Props { caption: string; components: { key: string; label: string; maxPoints: number }[]; showFamily?: boolean }
const { caption, components, showFamily = false } = Astro.props;
const max = Math.max(...components.map((c) => c.maxPoints), 1);
const rows = components.map((c) => ({ ...c, ...weightFor(c.key) })).sort((a, b) => b.maxPoints - a.maxPoints);
---
<div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-lift">
  <div class="overflow-x-auto" tabindex="0" role="region" aria-label={`${caption}, scrolls sideways`}>
    <table class="weights">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          <th scope="col">Score component</th>
          <th scope="col" class="num-col">Weight (pts)</th>
          <th scope="col" class="num-col">Half-life</th>
          {showFamily && <th scope="col" class="fam-col">Family</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            <td class="num-col">
              <span class="inline-flex items-center justify-end gap-3">
                <svg class="h-1.5 w-20 shrink-0 text-gold-strong" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
                  <rect class="bar-track" width="100" height="6" rx="3" />
                  <rect width={((r.maxPoints / max) * 100).toFixed(1)} height="6" rx="3" fill="currentColor" />
                </svg>
                <span class="mono min-w-[3.25rem] text-right text-sm font-semibold text-ink">{r.weight}</span>
              </span>
            </td>
            <td class="num-col mono text-xs text-ink-muted">{r.halfLife}</td>
            {showFamily && (
              <td class="fam-col">
                <span class="status-pill">{r.family}</span>
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
<style>
  .weights { width: 100%; min-width: 38rem; border-collapse: collapse; font-size: 15px; text-align: left; }
  .weights th, .weights td { padding: 0.9375rem 1.25rem; border-top: 1px solid rgb(226 232 240 / 0.7); vertical-align: middle; }
  .weights thead th { border-top: 0; border-bottom: 1px solid var(--color-line); background: rgb(241 245 249 / 0.7); padding-block: 0.875rem; font-family: var(--font-mono); font-size: var(--text-2xs); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--color-ink-muted); }
  .weights tbody th { font-weight: 600; color: var(--color-ink); }
  .weights tbody tr:hover > * { background: rgb(247 246 242 / 0.7); }
  .num-col { text-align: right; white-space: nowrap; }
  .fam-col { text-align: right; white-space: nowrap; width: 1%; }
</style>
