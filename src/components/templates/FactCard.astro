---
/** The dark "at a glance" card beside a page H1. Rows are label and value pairs. */
interface Props { title: string; rows: { label: string; value: string }[]; note?: string }
const { title, rows, note } = Astro.props;
---
<aside class="card-dark" aria-label={title}>
  <p class="eyebrow">{title}</p>
  <dl class="mt-4 text-[14.5px]">
    {rows.map((r) => (
      <div class="flex justify-between gap-4 border-b border-line-dark py-3 last:border-b-0">
        <dt class="shrink-0 text-on-dark-faint">{r.label}</dt>
        <dd class="text-right text-on-dark">{r.value}</dd>
      </div>
    ))}
  </dl>
  {note && <p class="mt-3 text-[13px] text-on-dark-faint">{note}</p>}
</aside>
