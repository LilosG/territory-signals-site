---
/**
 * The home hero's product shot: the Today screen of the demo workspace, with the newest signal and the top lead's
 * score breakdown floating beside it. Every number is computed from the demo data (data/demo.ts) with the real formula.
 */
import ScoreRing from '../ui/ScoreRing.astro';
import ScoreBreakdown from './ScoreBreakdown.astro';
import { TOP_LEADS, TOP_LEAD_DETAIL, WEEK, WORKSPACE, AREA } from '../../data/demo.ts';
import { tierOf } from '../../lib/tiers.ts';

const leads = TOP_LEADS.slice(0, 3);
const immediate = TOP_LEADS.filter((l) => tierOf(l.score).key === 'immediate').length;
const RAIL = [
  { group: 'Work', items: [['Today', ''], ['Leads', '2,418'], ['Outreach', String(WEEK.drafts)], ['Pipeline', '']] },
  { group: 'Opportunities', items: [['Territory map', ''], ['Playbooks', ''], ['Off-market', '']] },
  { group: 'Market', items: [['Trends', ''], ['Briefings', '']] },
];
const status = ['Draft ready', 'Draft ready', 'New'];
const top = TOP_LEAD_DETAIL;
---
<div class="hero-workspace">
  <div class="workspace-glow" aria-hidden="true"></div>
  <figure class="window workspace" aria-label={`Sample: the Today view of the ${WORKSPACE} workspace`}>
    <div class="flex min-h-[32.5rem]">
      <aside class="rail hidden md:block">
        <p class="flex items-center gap-2.5 px-1.5 font-semibold text-on-dark"><span class="rail-mark">DT</span>{WORKSPACE}</p>
        {RAIL.map((g) => (
          <div>
            <p class="rail-group">{g.group}</p>
            <ul>
              {g.items.map(([label, count], i) => (
                <li class:list={['rail-item', g.group === 'Work' && i === 0 && 'rail-item-current']}>{label}{count && <span class="mono text-[11px] text-on-dark-faint">{count}</span>}</li>
              ))}
            </ul>
          </div>
        ))}
      </aside>
      <div class="workspace-main">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="mono text-[11px] tracking-[0.08em] text-ink-muted uppercase">Mon · {WEEK.label}</p>
            <p class="mt-1 text-[22px] font-semibold tracking-heading">Good morning, {WORKSPACE}</p>
          </div>
          <p class="flex items-center gap-2"><span class="rounded-md border border-line bg-surface px-2.5 py-1.5 text-xs">Territory: {AREA}</span><span class="sample-pill">Sample</span></p>
        </div>
        <dl class="mt-[18px] grid grid-cols-[repeat(auto-fit,minmax(8rem,1fr))] gap-3">
          <div class="kpi"><dt>New signals</dt><dd>{WEEK.newSignals}</dd></div>
          <div class="kpi"><dt>Immediate leads</dt><dd class="text-tier-immediate">{immediate}</dd></div>
          <div class="kpi"><dt>Drafts to approve</dt><dd>{WEEK.drafts}</dd></div>
          <div class="kpi"><dt>Conversations</dt><dd>{WEEK.conversations}</dd></div>
        </dl>
        <div class="mt-3.5 overflow-hidden rounded-[10px] border border-line bg-surface">
          <p class="flex flex-wrap justify-between gap-x-3 gap-y-1 border-b border-[#eef0f3] px-4 py-3 text-[13px] font-semibold">Top leads this week<span class="font-normal text-ink-muted">Ranked by score</span></p>
          <ol>
            {leads.map((l, i) => (
              <li class="lead-row">
                <div class="min-w-0 flex-1">
                  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold"><span>{l.address}</span><span class="tag-dark">{l.recipe}</span></p>
                  <p class="mt-1 text-[12.5px] text-ink-muted">{l.signal}</p>
                </div>
                <span class:list={['hidden whitespace-nowrap rounded-full px-2.5 py-1 text-[11px] leading-none font-semibold sm:inline-flex items-center', status[i] === 'New' ? 'bg-sunken text-ink-muted' : 'bg-usable-soft text-usable']}>{status[i]}</span>
                <ScoreRing score={l.score} size="md" />
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </figure>
  <div class="float float-signal hidden lg:block" aria-hidden="true">
    <p class="mono text-[10.5px] tracking-[0.08em] text-gold-bright uppercase">New signal · City STR licenses</p>
    <p class="mt-1.5 text-sm font-semibold">Rental license no longer listed</p>
    <p class="mt-1 text-[12.5px] text-on-dark-faint">{top.address} · matched by location · 90%</p>
  </div>
  <div class="float float-score hidden lg:block" aria-hidden="true">
    <p class="mono text-[10.5px] tracking-[0.08em] text-ink-muted uppercase">Score breakdown · {top.address}</p>
    <div class="mt-3"><ScoreBreakdown items={top.breakdown} score={top.score} /></div>
    <p class="mt-3 text-[11.5px] text-ink-muted">{top.families} signal families · stacking ×{top.multiplier.toFixed(2)} · score {top.score}</p>
  </div>
</div>
<style>
  .hero-workspace { position: relative; max-width: 70rem; margin-inline: auto; text-align: left; }
  .workspace-glow { position: absolute; inset: 2.5rem 8% auto; height: 26rem; background: radial-gradient(closest-side, rgb(201 162 75 / 0.18), transparent 72%); }
  .workspace { position: relative; border-radius: 14px 14px 0 0; }
  .rail { width: 13rem; flex: none; padding: 1.25rem 0.875rem; background: var(--color-obsidian-rail); color: var(--color-on-dark-muted); font-size: 13px; }
  .rail-mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 7px; background: var(--color-gold); color: var(--color-obsidian); font-size: 12px; font-weight: 700; }
  .rail-group { margin: 1.25rem 0.375rem 0.5rem; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-on-dark-faint); }
  .rail-item { display: flex; justify-content: space-between; padding: 0.5rem 0.625rem; border-radius: 6px; }
  .rail-item-current { background: rgb(255 255 255 / 0.07); color: var(--color-on-dark); }
  .workspace-main { flex: 1; min-width: 0; padding: clamp(0.875rem, 2vw, 1.5rem); background: #f8f9fb; }
  .kpi { padding: 0.875rem; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-surface); }
  .kpi dt { font-size: 12px; color: var(--color-ink-muted); }
  .kpi dd { margin-top: 0.375rem; font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .lead-row { display: flex; align-items: center; gap: 0.875rem; padding: 0.75rem 1rem; border-top: 1px solid #eef0f3; }
  .lead-row:first-child { border-top: 0; }
  .float { position: absolute; border-radius: 12px; box-shadow: 0 24px 60px -12px rgb(0 0 0 / 0.6); }
  .float-signal { left: -1.75rem; top: 23rem; width: 14.5rem; padding: 0.875rem 1rem; background: var(--color-obsidian-raised); color: var(--color-on-dark); border: 1px solid rgb(255 255 255 / 0.1); }
  .float-score { right: -1.75rem; top: 15.5rem; width: 19rem; padding: 1rem; background: var(--color-surface); color: var(--color-ink); }
  .float-score :global(p.text-sm) { font-size: 12.5px; }
  @media (max-width: 80rem) { .float-signal { left: 0.75rem; } .float-score { right: 0.75rem; } }
</style>
