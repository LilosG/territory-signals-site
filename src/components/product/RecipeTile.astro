---
/** One recipe card: the catalog's verbatim label and short description beside an invented example score. */
import ScoreRing from '../ui/ScoreRing.astro';
import { RECIPE_EXAMPLES } from '../../data/demo.ts';
interface Props { href: string; recipeKey: string; label: string; description: string; mark?: string | undefined }
const { href, recipeKey, label, description, mark } = Astro.props;
const example = RECIPE_EXAMPLES[recipeKey]!;
---
<li class="flex">
  <a href={href} class="recipe-card">
    <span class="flex items-start justify-between gap-4">
      <span class="font-serif text-xl leading-snug font-medium">{label}</span>
      <ScoreRing score={example.score} size="md" />
    </span>
    <span class="text-[15px] leading-relaxed text-ink-muted">{description}</span>
    <span class="mt-auto flex flex-col gap-2.5 border-t border-line pt-3">
      <span class="mono text-xs text-ink-muted">{example.signal}</span>
      {mark && <span class="recipe-mark">{mark}</span>}
    </span>
  </a>
</li>
<style>
  .recipe-card {
    display: flex; flex: 1; flex-direction: column; gap: 0.75rem; padding: 1.375rem 1.5rem;
    border: 1px solid var(--color-line); border-top: 3px solid var(--color-line); border-radius: var(--radius-lg);
    background: var(--color-surface); color: var(--color-ink); box-shadow: var(--shadow-xs);
    transition: transform var(--duration-fast) var(--ease-quiet), box-shadow var(--duration-fast) var(--ease-quiet), border-color var(--duration-fast);
  }
  .recipe-card:hover, .recipe-card:focus-visible { transform: translateY(-4px); border-top-color: var(--color-gold); box-shadow: var(--shadow-lift); }
  .recipe-mark {
    align-self: flex-start; display: inline-flex; align-items: center; white-space: nowrap;
    border: 1px solid var(--color-line-strong); border-radius: var(--radius-full); padding: 0.25rem 0.6875rem;
    font-family: var(--font-mono); font-size: var(--text-2xs); line-height: 1.2; text-transform: uppercase; letter-spacing: var(--tracking-eyebrow); color: var(--color-ink-muted);
  }
</style>
