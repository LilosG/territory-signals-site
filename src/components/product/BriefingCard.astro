---
import Frame from './Frame.astro';
import { BRIEFING } from '../../data/demo.ts';
---
<Frame title="Today">
  <div class="on-dark bg-obsidian p-6 text-on-dark">
    <p class="eyebrow-gold">Weekly territory briefing · {BRIEFING.week}</p>
    <p class="mt-3 flex flex-wrap items-center gap-2"><span class="text-xl font-semibold tracking-heading">{BRIEFING.title}</span><span class="ai-tag">AI summary</span></p>
    <p class="mt-3 text-on-dark-muted">{BRIEFING.intro}</p>
    <p class="mt-5 flex flex-wrap items-center gap-4 text-sm">
      <span class="rounded-md border border-line-dark px-3 py-2 font-semibold">Copy newsletter block</span>
      <span class="text-gold-bright">Read the full briefing →</span>
    </p>
  </div>
</Frame>
