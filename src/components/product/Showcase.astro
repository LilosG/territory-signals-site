---
/** The product shot: the Today screen, then the quick dossier and the outreach co-pilot side by side beneath it. */
import DashboardScreen from './DashboardScreen.astro';
import DossierPanel from './DossierPanel.astro';
import OutreachCoPilot from './OutreachCoPilot.astro';
---
<div class="showcase">
  <div class="showcase-screen"><div class="showcase-tilt"><DashboardScreen /></div></div>
  <div class="showcase-cards">
    <div class="showcase-card showcase-dossier"><DossierPanel /></div>
    <div class="showcase-card showcase-copilot"><OutreachCoPilot /></div>
  </div>
</div>
<style>
  .showcase-tilt { border-radius: var(--radius-xl); box-shadow: var(--shadow-window); }
  .showcase-cards { display: grid; gap: 1.5rem; margin-top: 1.5rem; align-items: start; }
  .showcase-card { border-radius: var(--radius-xl); box-shadow: var(--shadow-float); }
  @media (min-width: 64rem) {
    .showcase-cards { grid-template-columns: 5fr 7fr; }
    .showcase-screen { perspective: 2000px; }
    .showcase-tilt { transform-origin: 50% 100%; }
    @supports (animation-timeline: view()) {
      /* Longhands only: the CSS minifier folds the timeline into the shorthand, which browsers reject. */
      .showcase-tilt { animation-name: flatten; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 10% cover 45%; }
    }
  }
  @keyframes flatten { from { transform: rotateX(9deg) scale(0.97); } to { transform: rotateX(0deg) scale(1); } }
</style>
