---
import { tierOf } from '../../lib/tiers.ts';
interface Props { items: { label: string; points: number; max: number }[]; score: number }
const { items, score } = Astro.props;
const tier = tierOf(score).key;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
---
<ul class="flex flex-col gap-3">
  {items.map((i) => (
    <li>
      <p class="flex items-baseline justify-between gap-3 text-sm">
        <span class="min-w-0">{i.label}</span>
        <span class="num shrink-0 text-ink-muted">+{fmt(i.points)} / {i.max}</span>
      </p>
      <svg class:list={['mt-1.5 h-1 w-full', `tier-${tier}`]} viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true">
        <rect class="bar-track" width="100" height="4" />
        <rect width={Math.min(100, (i.points / i.max) * 100).toFixed(1)} height="4" fill="currentColor" />
      </svg>
    </li>
  ))}
</ul>
<style is:global>
  .bar-track { fill: var(--color-line); }
</style>
