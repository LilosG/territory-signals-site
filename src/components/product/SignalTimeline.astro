---
import Frame from './Frame.astro';
import { TIMELINE } from '../../data/demo.ts';
---
<Frame title="Signal timeline">
  <ol class="p-4">
    {TIMELINE.map((t) => (
      <li class="relative border-l border-line pb-5 pl-5 last:pb-0">
        <svg class="absolute top-1.5 -left-1.5 size-3" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="currentColor" /></svg>
        <p class="text-sm font-medium">{t.title}</p>
        <p class="num text-xs text-ink-muted"><time datetime={t.iso}>{t.date}</time></p>
        <p class="mt-1 text-xs text-ink-muted">{t.source} · <span class="mono">{t.record}</span></p>
        <p class="mt-1 flex items-center gap-2 text-xs text-ink-muted">
          <svg class="h-1 w-10" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true"><rect class="bar-track" width="100" height="4" /><rect width={t.confidence} height="4" fill="currentColor" /></svg>
          {t.match} · {t.confidence}%
        </p>
      </li>
    ))}
  </ol>
</Frame>
<style is:global>
  .bar-track { fill: var(--color-line); }
</style>
