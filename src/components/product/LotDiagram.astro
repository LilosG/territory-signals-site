---
/**
 * The product's fallback lot drawing (D23), using real parcel geometry cropped around one lot. The lot facts printed
 * on it are invented, it is not a survey, and it replaces any aerial imagery.
 */
import block from '../../data/parcel-block.json';
import { LEAD } from '../../data/demo.ts';
const [cx, cy] = block.subjectCenter as [number, number];
const VIEW = { w: 600, h: 300 };
---
<svg class="lot-diagram h-auto w-full rounded-md border border-line bg-sunken" viewBox={`${cx - VIEW.w / 2} ${cy - VIEW.h / 2} ${VIEW.w} ${VIEW.h}`} width="400" height="200" role="img" aria-label={`Schematic lot diagram, ${LEAD.lot}, zone ${LEAD.zoning}. Not a survey.`}>
  <g class="lot-neighbors">{block.paths.map((d) => <path d={d} />)}</g>
  <path class="lot-line" d={block.paths[block.subject]} />
  <g transform={`translate(${cx - VIEW.w / 2} ${cy - VIEW.h / 2})`}>
    <rect class="lot-label" x="8" y="8" width="268" height="26" rx="4" />
    <text class="lot-text" x="16" y="26">SCHEMATIC · NOT A SURVEY</text>
    <rect class="lot-label" x="8" y={VIEW.h - 34} width="268" height="26" rx="4" />
    <text class="lot-text" x="16" y={VIEW.h - 16}>{LEAD.zoning} · {LEAD.lot.toUpperCase()}</text>
  </g>
</svg>
<style>
  .lot-neighbors path { fill: var(--color-surface); stroke: var(--color-slate-line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .lot-line { fill: var(--color-gold-soft); stroke: var(--color-gold); stroke-width: 2.5; vector-effect: non-scaling-stroke; }
  .lot-label { fill: var(--color-surface); fill-opacity: 0.92; }
  .lot-text { fill: var(--color-ink-muted); font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.08em; }
</style>
