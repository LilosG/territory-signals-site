---
import type { CollectionEntry } from 'astro:content';
import StandardPage from './StandardPage.astro';
import Section from '../components/layout/Section.astro';
import QaGrid from '../components/layout/QaGrid.astro';
import ListCard from '../components/templates/ListCard.astro';
import RelatedLinks from '../components/ui/RelatedLinks.astro';
import { entries, linkList } from '../lib/collections.ts';
import { metaOf } from '../lib/entry-meta.ts';
import { service } from '../lib/schema.ts';

interface Props { entry: CollectionEntry<'audiences'> }
const { entry } = Astro.props;
const d = entry.data;
const s = d.sections;
const recipes = (await entries('recipes')).filter((r) => d.recipes.includes(r.id));
const platform = (await entries('platform')).filter((p) => d.platform.includes(p.id));
---
<StandardPage meta={metaOf('audiences', entry)} answer={d.answer} eyebrow="Who it is for" schema={[service()]}
  request="Tell us how your team works its area today."
  cta={{ title: `Is Before They Sell a fit for ${d.headingTerm}?`, text: 'Bring your planning areas and your team size. We show what the records cover and where they stop.' }}>
  <ListCard
    slot="aside"
    title={`Configured for ${d.headingTerm}`}
    stats={[
      { value: String(recipes.length), label: 'Playbooks' },
      { value: String(platform.length), label: 'Surfaces' },
      { value: 'Weekly', label: 'Refresh' },
    ]}
    rows={[
      ...recipes.map((r) => ({ label: r.data.crumb, value: 'Playbook' })),
      ...platform.map((p) => ({ label: p.data.crumb, value: 'Surface', muted: true })),
    ]}
    note="Dedicated deployment scoped to your chosen planning areas."
  />

  <QaGrid items={[s.problem, s.signals]} />

  <Section>
    <div class="max-w-3xl">
      <p class="eyebrow">Weekly workflow</p>
      <h2 class="mt-4">{s.week.q}</h2>
      {s.week.p.map((text) => <p class="mt-4 text-lg leading-relaxed text-ink-muted">{text}</p>)}
    </div>
    {s.week.list && (
      <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {s.week.list.map((step, i) => (
          <li class="card flex flex-col p-6">
            <p class="mono text-xs font-semibold text-gold-strong">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-3 text-[15px] leading-relaxed font-medium text-ink">{step}</p>
          </li>
        ))}
      </ol>
    )}
  </Section>

  <QaGrid items={[s.setup, s.fit]} />

  <Section>
    <div class="grid-12">
      <div class="col-lead"><RelatedLinks title="Playbooks to start with" links={linkList('recipes', recipes)} /></div>
      <div class="col-support"><RelatedLinks title="Platform surfaces" links={linkList('platform', platform)} /></div>
    </div>
  </Section>
</StandardPage>
