---
import type { CollectionEntry } from 'astro:content';
import StandardPage from './StandardPage.astro';
import Section from '../components/layout/Section.astro';
import QaSection from '../components/layout/QaSection.astro';
import QaGrid from '../components/layout/QaGrid.astro';
import DataTable from '../components/ui/DataTable.astro';
import Badge from '../components/ui/Badge.astro';
import RelatedLinks from '../components/ui/RelatedLinks.astro';
import RuleCard from '../components/templates/RuleCard.astro';
import SampleLead from '../components/templates/SampleLead.astro';
import SampleLetter from '../components/templates/SampleLetter.astro';
import { RECIPE_SAMPLES } from '../data/demo.ts';
import { describeCondition, RECIPES, weightFor } from '../lib/product.ts';
import { guidesFor, hrefOf, linkList, recipeReads, signalsForRecipe } from '../lib/collections.ts';
import { sourceByKey } from '../data/sources.ts';
import { metaOf } from '../lib/entry-meta.ts';
import { service } from '../lib/schema.ts';
import { CTA } from '../data/site.ts';
import Icon from '../components/ui/Icon.astro';

interface Props { entry: CollectionEntry<'recipes'> }
const { entry } = Astro.props;
const d = entry.data;
const meta = metaOf('recipes', entry);
const s = d.sections;
const rule = RECIPES[d.recipeKey]!;
const signals = await signalsForRecipe(d.recipeKey);
const guides = await guidesFor('recipes', [entry.id]);
const sources = [...new Set(signals.flatMap((x) => x.data.sources))].map(sourceByKey);
const weights = signals.map((x) => [
  { text: x.data.crumb, href: hrefOf('signals', x.id) },
  x.data.components.filter((c) => recipeReads(d.recipeKey, c.key)).map((c) => `${c.label}: ${weightFor(c.key).weight}`).join('; '),
]);
const SAMPLE_ADDRESS: Record<string, string> = {
  str_exit: '2315 Sample St', tired_landlord: '418 Sample Ct', builder_bait: '77 Sample Way', pre_list_prep: '1200 Sample Ave',
  stalled_project: '602 Sample Dr', downsizer: '905 Sample Pl', insurance_squeeze: '14 Sample Ridge', financial_pressure: '330 Sample Ave', quiet_inheritance: '58 Sample Ln',
};
const address = SAMPLE_ADDRESS[d.recipeKey] ?? '100 Sample St';
const sample = RECIPE_SAMPLES[d.recipeKey as keyof typeof RECIPE_SAMPLES];
const ruleLine = describeCondition(rule.when);
const article = /^[aeiou]/i.test(d.headingTerm) ? 'an' : 'a';
const capTerm = d.headingTerm.charAt(0).toUpperCase() + d.headingTerm.slice(1);
const sourceNote = `Facts come from ${sources.map((x) => x.publisher.replace(/^SANDAG \(.*\)$/, 'SANDAG')).filter((v, i, a) => a.indexOf(v) === i).join(', ')}.`;
---
<StandardPage block meta={meta} answer={d.answer} eyebrow="Seller playbook" schema={[service()]}
  request="yes"
  cta={{ title: `See the ${d.headingTerm} leads in your San Diego farm`, text: 'We walk through the records behind each playbook and which of them your territory has.' }}>
  <Fragment slot="intro">{d.mark && <p class="mt-4"><Badge tone="outline">{d.mark}</Badge></p>}</Fragment>
  <Fragment slot="aside"><RuleCard line={ruleLine} note={sourceNote} /></Fragment>

  {d.approval && (
    <Section>
      <div class="flex flex-wrap items-start gap-6 rounded-2xl border border-ink p-6" data-approval>
        <div class="min-w-0 flex-[1_1_20rem]"><p class="eyebrow">Team approval required</p><p class="mt-3 text-lg">{d.approval}</p></div>
        <a class="arrow-link" href="/compliance">How sensitive records are handled →</a>
      </div>
    </Section>
  )}

  <QaGrid items={[s.what, s.why]} />

  {sample && (
    <Section>
      <div class="grid-12 items-center gap-y-12">
        <div class="min-w-0 lg:col-span-5">
          <p class="eyebrow">How it scores</p>
          <h2 class="mt-4">How {article} {d.headingTerm} lead scores in San Diego</h2>
          <p class="mt-5 text-lg leading-relaxed text-ink-muted">Matching the playbook adds no points. The score comes only from the signals and owner facts on the parcel, and a second signal family stacks on top. This invented parcel shows the arithmetic.</p>
          <p class="mt-6"><a class="arrow-link" href={CTA.demo.href}>{CTA.demo.label} →</a></p>
        </div>
        <div class="min-w-0 lg:col-span-6 lg:col-start-7"><SampleLead address={address} recipe={d.label} sample={sample} /></div>
      </div>
    </Section>
  )}

  <Section>
    <div class="grid-12 items-center gap-y-12">
      <div class="min-w-0 lg:col-span-6"><SampleLetter recipeKey={d.recipeKey} address={address} /></div>
      <div class="min-w-0 lg:col-span-5 lg:col-start-8">
        <p class="eyebrow">What your team sends</p>
        <h2 class="mt-4">{capTerm} outreach letters, emails and call scripts</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-muted">Every draft uses only facts on record, never mentions a score or a sensitive record, and can’t be approved until the agent’s name and DRE number are on it.</p>
        <ul class="check-list mt-6 text-base">
          <li><Icon name="check" class="mt-1 size-4 text-gold-strong" />Letter, email and call script for every lead</li>
          <li><Icon name="check" class="mt-1 size-4 text-gold-strong" />Edited and approved by an agent</li>
          <li><Icon name="check" class="mt-1 size-4 text-gold-strong" />Sent by your team, never automatically</li>
        </ul>
      </div>
    </div>
  </Section>

  <QaSection {...s.source} layout="wide">
    <DataTable caption={`Data sources behind the ${d.label} recipe`} columns={['Source', 'What it provides', 'Verdict']}
      rows={sources.map((src) => [{ text: src.name, href: src.url, icon: src.key }, src.provides, { text: src.verdict, pill: true }])} />
  </QaSection>
  <QaSection {...s.scoring} layout="wide">
    <DataTable caption={`Component weights behind the ${d.label} recipe`} columns={['Signal page', 'Components this rule reads, with weights']} rows={weights} />
  </QaSection>

  <QaGrid items={[s.action, s.limits]} />

  <Section>
    <div class="grid gap-8 md:grid-cols-3">
      <RelatedLinks title="Signals this playbook reads" links={linkList('signals', signals)} />
      <RelatedLinks title="Related guides" links={guides.map((g) => ({ href: hrefOf('guides', g.id), label: g.data.h1 }))} />
      <RelatedLinks title="More" links={[{ href: '/recipes', label: 'All seller playbooks' }, { href: '/glossary', label: 'Glossary' }]} />
    </div>
  </Section>
</StandardPage>
