---
import type { CollectionEntry } from 'astro:content';
import StandardPage from './StandardPage.astro';
import Section from '../components/layout/Section.astro';
import QaSection from '../components/layout/QaSection.astro';
import DataTable from '../components/ui/DataTable.astro';
import RelatedLinks from '../components/ui/RelatedLinks.astro';
import { entries, linkList } from '../lib/collections.ts';
import { metaOf } from '../lib/entry-meta.ts';

interface Props { entry: CollectionEntry<'compare'> }
const { entry } = Astro.props;
const d = entry.data;
const s = d.sections;
const source = (id: string) => {
  const found = d.sources.find((x) => x.id === id);
  if (!found) throw new Error(`${entry.id}: unknown source ${id}`);
  return found;
};
const others = (await entries('compare')).filter((c) => c.id !== entry.id);
---
<StandardPage meta={metaOf('compare', entry)} answer={d.answer} eyebrow={`Comparison · facts as of ${d.asOf}`}
  request="Compare for yourself against your own planning areas."
  cta={{ title: `Weighing a ${d.headingTerm} for your team?`, text: 'A walkthrough shows the records, rules and approval steps so you can compare them with what you use now.' }}>
  <QaSection {...s.differ} />
  <QaSection {...s.publishes} />
  <Section>
    <div class="stack">
      <h2>{d.tableQuestion}</h2>
      <p class="max-w-measure">{d.tableAnswer}</p>
      <DataTable caption={`Territory Signals and ${d.competitor}, side by side`} columns={['Question', 'Territory Signals', d.competitor]}
        rows={d.rows.map((r) => [r.dimension, r.us, { text: r.them, note: `${source(r.source).name}, as of ${source(r.source).asOf}` }])} />
    </div>
  </Section>
  <QaSection {...s.better} />
  <QaSection {...s.evaluate} />
  <Section>
    <div class="grid-12">
      <div class="col-lead">
        <p class="eyebrow">Sources for statements about {d.competitor}</p>
        <ul class="mt-3 border-t border-ink">
          {d.sources.map((x) => <li class="border-b border-line py-3"><a class="link" href={x.url} rel="noopener nofollow">{x.name}</a> <span class="text-sm text-ink-muted">as of {x.asOf}</span></li>)}
        </ul>
        {d.note && <p class="mt-4 max-w-measure text-sm text-ink-muted">{d.note}</p>}
        <p class="mt-4 max-w-measure text-sm text-ink-muted">{d.competitor} is a trademark of its owner. Territory Signals is not affiliated with or endorsed by that company. Products change, so check the source before you decide.</p>
      </div>
      <div class="col-support"><RelatedLinks title="Other comparisons" links={linkList('compare', others)} /></div>
    </div>
  </Section>
</StandardPage>
