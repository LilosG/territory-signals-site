---
import type { CollectionEntry } from 'astro:content';
import StandardPage from './StandardPage.astro';
import Section from '../components/layout/Section.astro';
import QaSection from '../components/layout/QaSection.astro';
import DataTable from '../components/ui/DataTable.astro';
import Badge from '../components/ui/Badge.astro';
import FactCard from '../components/templates/FactCard.astro';
import WeightTable from '../components/templates/WeightTable.astro';
import RelatedLinks from '../components/ui/RelatedLinks.astro';
import { PIPELINE_CADENCE, sourceByKey } from '../data/sources.ts';
import { weightFor } from '../lib/product.ts';
import { guidesFor, hrefOf, recipesForSignal } from '../lib/collections.ts';
import { metaOf } from '../lib/entry-meta.ts';
import { service } from '../lib/schema.ts';
import { CTA } from '../data/site.ts';

interface Props { entry: CollectionEntry<'signals'> }
const { entry } = Astro.props;
const d = entry.data;
const meta = metaOf('signals', entry);
const s = d.sections;
const sources = d.sources.map(sourceByKey);
const recipes = await recipesForSignal(entry.id);
const guides = await guidesFor('signals', [entry.id]);
const decaying = d.components
  .map((c) => ({ c, w: weightFor(c.key) }))
  .filter(({ c, w }) => c.maxPoints > 0 && /^\d+ days$/.test(w.halfLife))
  .sort((a, b) => b.c.maxPoints - a.c.maxPoints)[0];
const example = decaying
  ? `Example: a ${decaying.c.maxPoints}-point “${decaying.c.label.toLowerCase()}” signal from ${decaying.w.halfLife} ago counts ${decaying.c.maxPoints / 2} points today.`
  : undefined;
const top = Math.max(...d.components.map((c) => c.maxPoints));
const facts = [
  { label: sources.length > 1 ? 'Sources' : 'Source', value: sources.map((x) => x.publisher).join('; ') },
  { label: 'Refresh', value: 'Weekly run' },
  { label: 'Matched by', value: sources[0]!.join },
  { label: 'Top weight', value: top > 0 ? `${top} points` : 'Context only' },
  { label: 'Used by', value: recipes.length ? recipes.map((r) => r.data.label).join(', ') : 'Parcel score only' },
];
---
<StandardPage block meta={meta} answer={d.answer} eyebrow={`Seller signal · ${d.family} family`} schema={[service()]}
  request="yes"
  cta={{ title: d.status === 'coming' ? `Questions about ${d.headingTerm} data for your San Diego farm?` : 'See this signal across your San Diego farm', text: 'We walk through your planning areas, the sources that cover them and how each record would score.' }}>
  <Fragment slot="intro">{d.status === 'coming' && <p class="mt-4"><Badge tone="outline">Coming: not loaded yet</Badge></p>}</Fragment>
  <Fragment slot="aside"><FactCard title="At a glance" rows={facts} note={d.visibility} /></Fragment>

  <QaSection {...s.what} />
  <QaSection {...s.why} layout="quote" />
  <QaSection {...s.scoring} layout="wide">
    <WeightTable caption={`Score weights for ${d.crumb.toLowerCase()}`} components={d.components} />
    {example && (
      <div class="on-dark flex flex-wrap items-center justify-between gap-3 rounded-xl bg-obsidian px-6 py-5 text-on-dark">
        <p class="text-[15px]">{example}</p>
        <a class="arrow-link" href={CTA.demo.href}>{CTA.demo.label} →</a>
      </div>
    )}
  </QaSection>
  <QaSection {...s.source} layout="wide">
    <DataTable caption={`Sources for ${d.crumb.toLowerCase()}`} columns={['Source', 'What it provides', 'How it joins to a parcel', 'Limits']}
      rows={sources.map((src) => [{ text: src.name, href: src.url, icon: src.key }, src.provides, src.join, src.limits])} />
    <p class="max-w-measure text-sm text-ink-muted">{PIPELINE_CADENCE} <a class="link" href="/data-sources">All data sources</a>.</p>
  </QaSection>
  <QaSection {...s.action} />
  <QaSection {...s.limits} />

  <Section>
    <h2 class="max-w-3xl">Seller playbooks that use this San Diego signal</h2>
    {recipes.length > 0 ? (
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {recipes.map((r) => (
          <li><a class="card block h-full transition-shadow hover:shadow-lift" href={hrefOf('recipes', r.id)}>
            <p class="font-serif text-[26px] font-medium">{r.data.label}</p>
            <p class="mt-2.5 text-[15px] leading-relaxed text-ink-muted">{r.data.shortDescription}</p>
            <p class="mono mt-5 text-xs text-gold-strong uppercase">View playbook →</p>
          </a></li>
        ))}
      </ul>
    ) : <p class="mt-6 text-ink-muted">No playbook uses this signal on its own. It contributes to the parcel score.</p>}
    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <RelatedLinks title="Related guides" links={guides.map((g) => ({ href: hrefOf('guides', g.id), label: g.data.h1 }))} />
      <RelatedLinks title="More" links={[{ href: '/signals', label: 'All signal families' }, { href: '/glossary', label: 'Glossary' }]} />
    </div>
  </Section>
</StandardPage>
