{
  "name": "territory-signals-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && node scripts/forbidden-terms.mjs && node scripts/check-meta.mjs && node scripts/check-catalog.mjs && node scripts/check-links.mjs && npm run test:unit && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "sync:product": "node scripts/sync-product.mjs",
    "map": "node scripts/build-map-paths.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "lucide-static": "1.81.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.7",
    "node-html-parser": "9.0.7",
    "satori": "0.63.2",
    "typescript": "5.9.3",
    "wrangler": "4.168.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261123.1": true,
    "fsevents@2.3.3": true
  }
}
